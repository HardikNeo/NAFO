# Firebase web app config — copy this file to `.env` and fill in your values.
# Get them from the Firebase console: Project settings → Your apps → Web app → SDK setup and configuration.
# Restart `npm run dev` after creating `.env`.
#
# Without these values the site still runs: the Notices page shows the
# "No notices yet" empty state and the contact form reports that Firebase
# isn't configured yet.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
