# Firebase web app config for production builds (`npm run build` / `vite build`).
#
# Committed on purpose so that CI (GitHub Actions) and local production builds
# both get a working Firestore connection. Local development still uses `.env`.
#
# The Firebase web API key is NOT a secret: it is a public project identifier
# that ships in the client bundle and is also exposed by Firebase Hosting at
# /__/firebase/init.json. Access is controlled by Firestore security rules
# (see firestore.rules), not by hiding these values.

VITE_FIREBASE_API_KEY=AIzaSyAdprc_yqQ5OyPGeH2cnxdbne4ZBLC9aNU
VITE_FIREBASE_AUTH_DOMAIN=financial-initiatives-nepal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=financial-initiatives-nepal
VITE_FIREBASE_STORAGE_BUCKET=financial-initiatives-nepal.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=109291682559
VITE_FIREBASE_APP_ID=1:109291682559:web:f6a637fb37efaa9f256aca

# Not read by the app (Firebase Analytics isn't wired up), kept for reference.
VITE_FIREBASE_MEASUREMENT_ID=G-8EPGWF2RPJ
