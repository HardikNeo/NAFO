rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read notices (they're public content).
    match /notices/{id} {
      allow read: if true;
      allow write: if false;
    }
    // Anyone can submit a contact message, but only you can read them.
    match /messages/{id} {
      allow read: if false;
      allow create: if true;
      allow update, delete: if false;
    }
    // Team members are public content (shown on the About page).
    match /team/{id} {
      allow read: if true;
      allow write: if false;
    }
    // District pages: public content (the selected / waitlisted result lists).
    // Add new district collection names to this list as districts are added.
    match /{district}/{id} {
      allow read: if district in [
        "kathmandu",
        "jumla",
        "dolpa",
        "jhapa",
        "kailali",
        "parsa",
        "morang",
        "kavre"
      ];
      allow write: if false;
    }
  }
}